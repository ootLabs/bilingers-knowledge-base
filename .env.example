# Copy to .env and adjust. Never commit .env.

# --- Postgres ---
POSTGRES_USER=bilingers
POSTGRES_PASSWORD=bilingers
POSTGRES_DB=bilingers
POSTGRES_PORT=5432

# --- Backend ---
BACKEND_PORT=8000
# Hostname "db" is the compose service name, not localhost.
DATABASE_URL=postgresql+psycopg://bilingers:bilingers@db:5432/bilingers
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info
# Model price list, read inside the backend container. Copy
# backend/pricing.example.json to backend/pricing.json (gitignored) and put
# the real prices and exchange rate there. Editing it needs no restart.
PRICING_FILE=/app/pricing.json

# --- Panel authentication (T-82) ---
# How long a panel session stays valid. Absolute, not idle: 12 hours covers a
# working day and forces a fresh login the next one.
PANEL_SESSION_TTL_MINUTES=720
# Wrong passwords before the account locks, and for how long it stays locked.
PANEL_LOGIN_MAX_ATTEMPTS=5
PANEL_LOGIN_LOCKOUT_MINUTES=15
# How long a password setup or reset token stays usable.
PANEL_PASSWORD_RESET_TTL_HOURS=24
# Login attempts allowed from one IP address within the window, before bcrypt
# is skipped and a 429 is returned instead.
PANEL_LOGIN_IP_MAX_ATTEMPTS=20
PANEL_LOGIN_IP_WINDOW_MINUTES=5

# --- Panel second factor (T-83) ---
# Encrypts TOTP secrets at rest, so a database dump alone does not hand over
# anybody's second factor. No default on purpose: a shared default key is the
# same as no key. Generate one per environment and keep it out of the repo:
#   docker compose exec backend python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# While this is empty, turning 2FA on is refused rather than storing a secret
# in the clear.
PANEL_TOTP_ENCRYPTION_KEY=
# Shown beside the code in the authenticator app.
PANEL_TOTP_ISSUER=Bilingers
# How many printable single-use codes are handed over when 2FA is switched on.
PANEL_BACKUP_CODE_COUNT=10

# --- Document import (T-85) ---
# Largest .docx the panel will read, in bytes. Enforced on the server, not only
# in the upload form. 5 MB is a generous chapter; the foundation's material is
# text, and anything far past this is a file full of images.
DOCX_IMPORT_MAX_BYTES=5242880

# --- Frontend ---
FRONTEND_PORT=3000
# Used by the browser, so it must be reachable from the host.
NEXT_PUBLIC_API_URL=http://localhost:8000
