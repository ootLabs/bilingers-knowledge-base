# Copy to .env and adjust. Never commit .env.

# --- Postgres ---
POSTGRES_USER=bilingers
POSTGRES_PASSWORD=bilingers
POSTGRES_DB=bilingers
POSTGRES_PORT=5432

# --- Backend ---
BACKEND_PORT=8000
# Hostname "db" is the compose service name, not localhost.
DATABASE_URL=postgresql+psycopg://bilingers:bilingers@db:5432/bilingers
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info

# --- Panel authentication (T-82) ---
# How long a panel session stays valid. Absolute, not idle: 12 hours covers a
# working day and forces a fresh login the next one.
PANEL_SESSION_TTL_MINUTES=720
# Wrong passwords before the account locks, and for how long it stays locked.
PANEL_LOGIN_MAX_ATTEMPTS=5
PANEL_LOGIN_LOCKOUT_MINUTES=15
# How long a password setup or reset token stays usable.
PANEL_PASSWORD_RESET_TTL_HOURS=24

# --- Frontend ---
FRONTEND_PORT=3000
# Used by the browser, so it must be reachable from the host.
NEXT_PUBLIC_API_URL=http://localhost:8000
